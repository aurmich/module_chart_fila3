     * @param \Illuminate\Http\Request $request
     * @return \Illuminate\Database\Eloquent\Model|null
     */
    protected function resolveTenant($request): ?Model
    {
        $panel = Filament::getCurrentPanel();
        
        if ($panel === null) {
            return null;
        }

        $routeKeyName = $panel->getTenantRouteKeyName() ?? 'tenant';
        $tenantId = $request->route($routeKeyName);

        if (blank($tenantId)) {
            return null;
        }

        $tenantModel = $panel->getTenantModel();
        if ($tenantModel === null) {
            return null;
        }

        try {
            $slugAttribute = $panel->getTenantSlugAttribute() ?? 'slug';
            
            /** @var class-string<\Illuminate\Database\Eloquent\Model> $tenantModel */
            $tenant = $tenantModel::where($slugAttribute, $tenantId)
                ->firstOrFail();
        } catch (ModelNotFoundException) {
            return null;
        }

        return $tenant;
    }
}
