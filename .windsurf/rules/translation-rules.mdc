            'label' => 'Etichetta Campo',
            'tooltip' => 'Descrizione di aiuto',
            'placeholder' => 'Esempio di input',
            'help' => 'Testo di aiuto sotto il campo'
        ],
        // Altri campi...
    ],
];
```

